# Scripts and configs run inside Linux containers: keep LF even when cloned on Windows (CRLF breaks #!/bin/sh).
* text=auto
*.sh      text eol=lf
*.mjs     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf
.env*example text eol=lf
*.ps1     text

# Left out of release packages (git archive / GitHub "Source code" zip): the first site's internal notes and history.
