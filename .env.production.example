# Production server settings. Copy to .env.production ON THE PRODUCTION SERVER ONLY, fill every value, then:
#   chmod 600 .env.production
#   sh scripts/prod-preflight.sh .env.production
# Never commit .env.production and never paste its values into chat, tickets or handoff notes.
# Generate each secret separately:  openssl rand -hex 32   (64 characters; each one different)
# Runbook: docs/ops/DEPLOY_PRODUCTION.md

# === Release ===
# The git tag being deployed, e.g. 1.0.0-rc1. Images are built as cctv-api:<this> and cctv-web-app:<this>,
# so the previous release's images stay on disk for rollback.
CCTV_VERSION=
COMPOSE_PROJECT_NAME=cctv-platform

# === Safety (fail closed) ===
# true only after checking this server cannot reach legacy Image Service production (192.168.60.x).
CCTV_ISOLATION_VERIFIED=false
# Never true on production.
ALLOW_DATA_LOSS=false
# true ONLY for the very first migrate on an empty database (creates roles, master data, admin user); then false.
RUN_SEED=false

# === Docker's own network: must not overlap any real LAN (camera LANs, office LAN, 192.168.60.x) ===
CCTV_DOCKER_SUBNET=10.250.0.0/24

# === Where people open the system (one LAN address of this server; never 0.0.0.0, never 192.168.60.x) ===
WEB_LAN_ADDRESS=
WEB_LAN_HTTP_PORT=80
WEB_LAN_HTTPS_PORT=443
# Localhost ports on the server itself (for the smoke test and admin work on the box)
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
# The address in links inside alerts/notifications, e.g. https://<WEB_LAN_ADDRESS>
PUBLIC_BASE_URL=
# Browser origins allowed to call the API cross-origin; the web app itself is same-origin. Usually = PUBLIC_BASE_URL.
CORS_ALLOWED_ORIGINS=
# Proxies in front of image-api (nginx = 1).
TRUST_PROXY_HOPS=1

# === Live video (WebRTC) for LAN browsers: this server's LAN address (same as WEB_LAN_ADDRESS) ===
MEDIA_UDP_BIND=
MEDIA_WEBRTC_HOST=

# === NTP server for the recorders: the address on the camera LAN the recorders can reach ===
NTP_BIND=
NTP_UPSTREAM=th.pool.ntp.org,pool.ntp.org
# Camera LAN subnet(s) allowed to ask for time, e.g. 192.168.20.0/24,192.168.30.0/24
NTP_ALLOW=

# === Recordings: folder on the recording disk (absolute path, outside the repo) ===
RECORDINGS_HOST_DIR=
RECORDINGS_CLEANUP_ENABLED=true
RECORDING_RETENTION_DAYS=30
RECORDINGS_QUARANTINE_PURGE_DAYS=7
RECORDINGS_QUARANTINE_DIR=/recordings/.quarantine
DISK_WARNING_THRESHOLD_PCT=85
DISK_CRITICAL_THRESHOLD_PCT=92
MAX_CONCURRENT_EXPORTS=2

# === Database ===
POSTGRES_USER=cctv_user
POSTGRES_DB=cctv_db
POSTGRES_PASSWORD=

# === Secrets: at least 32 characters, all different, none copied from Dev ===
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Encrypts recorder passwords at rest. Keep a copy in the password safe: without it, a restored backup
# cannot read the recorder passwords. Never change it after recorders are added.
ENCRYPTION_KEY=
SERVICE_API_KEY=
MEDIA_WEBHOOK_SECRET=

# === MinIO (image/snapshot storage) ===
MINIO_ACCESS_KEY=cctv-minio
MINIO_SECRET_KEY=
MINIO_BUCKET=image-service

# === Notifications (optional; leave empty if not used) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_ACCESS_TOKEN=

# === Cloudflare tunnel (not used; only with --profile tunnel) ===
TUNNEL_TOKEN=
