generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  operator
  viewer
  system

  @@map("role")
}

enum ProviderType {
  s3
  local
  smb
  nfs
  seaweedfs

  @@map("provider_type")
}

enum CameraStatus {
  active
  inactive
  error
  maintenance

  @@map("camera_status")
}

enum CameraEventType {
  online
  offline
  error
  recovering
  reconfigured
  maintenance_start
  maintenance_end
  image_deleted
  // Reachable, but the camera itself stopped producing — see checkCameraImageFlow().
  no_new_images
  images_resumed

  @@map("camera_event_type")
}

// ── CCTV Foundation Enums (Phase 1) ───────────────────────────
// Operational Status: system-derived reachability state (P35 Phase A).
// Kept separate from CameraStatus ("Business Status", human-controlled) so the
// two never conflict — analytics/automation read this one, workflows/permissions
// still read CameraStatus exactly as before.
enum CameraOperationalStatus {
  unknown
  online
  offline
  recovering

  @@map("camera_operational_status")
}

enum AlertSeverity {
  info
  warning
  critical
  emergency

  @@map("alert_severity")
}

enum AlertType {
  storage_warning
  processing_failure
  camera_offline
  camera_no_new_images
  rate_limit_exceeded
  retention_violation
  disk_space
  ingest_lag
  checksum_mismatch
  incident_escalation
  storage_cleanup
  hdd_problem
  recording_stopped
  clock_drift
  auth_anomaly

  @@map("alert_type")
}

model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  nameTh      String?  @map("name_th") @db.VarChar(256)
  nameEn      String?  @map("name_en") @db.VarChar(256)
  nameCn      String?  @map("name_cn") @db.VarChar(256)
  nameMm      String?  @map("name_mm") @db.VarChar(256)
  nameJp      String?  @map("name_jp") @db.VarChar(256)
  description String?  @db.Text
  permissions Json     @default("[]")
  // Which cameras people with this role may see.
  cameraScope Json? @map("camera_scope")
  /// Live tiles one person with this role may have at once; null follows live_max_streams_per_user.
  liveQuota   Int?     @map("live_quota")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("custom_roles")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  username          String    @unique @db.VarChar(128)
  email             String    @unique @db.VarChar(256)
  password          String    @db.Text
  role              String    @default("viewer") @db.VarChar(64)
  customPermissions Json      @default("[]") @map("custom_permissions")
  // A deleted account stays, switched off and out of every list: the audit log has to keep saying who did what.
  deletedAt         DateTime? @map("deleted_at")
  deletedBy         String?   @map("deleted_by") @db.VarChar(128)
  // Which cameras this person may see, on top of their role. Empty means none of their own.
  cameraScope       Json?     @map("camera_scope")
  /// This person's own live tile limit; null follows the role, then the system value.
  liveQuota         Int?      @map("live_quota")
  hiddenMenuItems   Json      @default("[]") @map("hidden_menu_items")
  // Per-user UI preferences (table column order/visibility, filter panel state,
  // etc.) keyed by page — follows the user across devices. Shape: { [pageId]: {...} }
  uiPreferences     Json      @default("{}") @map("ui_preferences")
  enabled           Boolean   @default(true)
  lastLogin         DateTime? @map("last_login")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  sessions      UserSession[]

  roleRelation CustomRole? @relation(fields: [role], references: [code])

  cameraFavorites CameraFavorite[]
  liveViews       LiveView[]

  @@map("users")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  username        String    @db.VarChar(128)
  loginAt         DateTime  @default(now()) @map("login_at")
  logoutAt        DateTime? @map("logout_at")
  lastActiveAt    DateTime  @default(now()) @map("last_active_at")
  durationSeconds Int?      @map("duration_seconds")
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  userAgent       String?   @map("user_agent") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, loginAt(sort: Desc)])
  @@map("user_sessions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.Text
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

/// Video retention: recordings of cameras using this policy are kept recordingRetentionDays, then moved
/// to quarantine and purged after RECORDINGS_QUARANTINE_PURGE_DAYS. Legal Hold always wins.
model RetentionPolicy {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String   @db.VarChar(128)
  description            String?  @db.Text
  recordingRetentionDays Int      @default(30) @map("recording_retention_days")
  isDefault              Boolean  @default(false) @map("is_default")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  cameras Camera[]
  cameraTemplates CameraTemplate[]

  @@map("retention_policies")
}

model StorageProvider {
  id            String       @id @default(uuid()) @db.Uuid
  name          String       @unique @db.VarChar(128)
  type          ProviderType
  config        Json
  isDefault     Boolean      @default(false) @map("is_default")
  isActive      Boolean      @default(true) @map("is_active")
  capacityBytes BigInt?      @map("capacity_bytes")
  priority      Int          @default(0)
  description   String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")

  metrics     StorageProviderMetric[]

  @@map("storage_providers")
}

model StorageProviderMetric {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @map("provider_id") @db.Uuid
  status       String   @default("unknown") @db.VarChar(32)
  latencyMs    Int      @default(0) @map("latency_ms")
  objectCount  BigInt   @default(0) @map("object_count")
  usedBytes    BigInt   @default(0) @map("used_bytes")
  totalBytes   BigInt   @default(0) @map("total_bytes")
  freeBytes    BigInt   @default(0) @map("free_bytes")
  errorMessage String?  @map("error_message") @db.Text
  collectedAt  DateTime @default(now()) @map("collected_at")

  provider StorageProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, collectedAt(sort: Desc)])
  @@map("storage_provider_metrics")
}

model CameraTemplate {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(128)
  description         String?  @db.Text
  retentionPolicyId   String?  @map("retention_policy_id") @db.Uuid
  isDefault           Boolean  @default(false) @map("is_default")
  sortOrder           Int      @default(0) @map("sort_order")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  cameras             Camera[]
  retentionPolicy     RetentionPolicy? @relation(fields: [retentionPolicyId], references: [id])

  @@map("camera_templates")
}

// Named sets of cameras that cut across site and DVR/NVR; one camera can be in several.
model CameraGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  description String?  @db.VarChar(255)
  /// Still-image refresh for the live overview, in seconds; null takes the next level up (see snapshots/refresh-tiers.ts).
  snapshotRefreshSeconds Int? @map("snapshot_refresh_seconds")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members CameraGroupMember[]

  @@map("camera_groups")
}

model CameraGroupMember {
  groupId  String @map("group_id") @db.Uuid
  cameraId String @map("camera_id") @db.Uuid

  group  CameraGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  camera Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([groupId, cameraId])
  @@index([cameraId])
  @@map("camera_group_members")
}

/// A saved live wall: layout plus which camera sits in which slot. Private to its owner unless shared with the team.
model LiveView {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(60)
  layout    String   @db.VarChar(8)
  /// [{ slotIndex, cameraId }]; cameras that are later deleted or out of a viewer's scope are left out when read.
  slots     Json     @default("[]")
  shared    Boolean  @default(false)
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([shared])
  @@map("live_views")
}

// A viewer's starred cameras: they get live video first in the Live Room.
model CameraFavorite {
  userId    String   @map("user_id") @db.Uuid
  cameraId  String   @map("camera_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([userId, cameraId])
  @@map("camera_favorites")
}

// ── CCTV Foundation Models (Phase 1) ──────────────────────────

model Site {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(128)
  code        String?  @unique @db.VarChar(64)
  description String?  @db.Text
  address     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  zones      Zone[]
  devices    Device[]
  cameras    Camera[]
  mediaNodes MediaNode[]

  @@map("sites")
}

model Zone {
  id                String   @id @default(uuid()) @db.Uuid
  siteId            String   @map("site_id") @db.Uuid
  name              String   @db.VarChar(128)
  code              String?  @db.VarChar(64)
  floor             Int?     @default(1)
  floorPlanImageUrl String?  @map("floor_plan_image_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  devices Device[]
  site    Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  cameras Camera[]

  @@unique([siteId, name])
  @@map("zones")
}

model MediaNode {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String    @unique @db.VarChar(128)
  apiBaseUrl          String    @map("api_base_url") @db.VarChar(256)
  rtspBaseUrl         String    @map("rtsp_base_url") @db.VarChar(256)
  webrtcBaseUrl       String    @map("webrtc_base_url") @db.VarChar(256)
  hlsBaseUrl          String    @map("hls_base_url") @db.VarChar(256)
  siteId              String?   @map("site_id") @db.Uuid
  region              String?   @default("default") @db.VarChar(64)
  isDefault           Boolean   @default(false) @map("is_default")
  status              String    @default("online") @db.VarChar(32) // online, degraded, offline, draining
  capacityChannels    Int       @default(100) @map("capacity_channels")
  currentLoadChannels Int       @default(0) @map("current_load_channels")
  cpuPercent          Float?    @default(0) @map("cpu_percent")
  ramPercent          Float?    @default(0) @map("ram_percent")
  diskPercent         Float?    @default(0) @map("disk_percent")
  networkIngressMbps  Float?    @default(0) @map("network_ingress_mbps")
  networkEgressMbps   Float?    @default(0) @map("network_egress_mbps")
  lastHeartbeatAt     DateTime? @map("last_heartbeat_at")
  iceServers          Json      @default("[]") @map("ice_servers")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  site                Site?     @relation(fields: [siteId], references: [id])
  cameras             Camera[]

  @@map("media_nodes")
}

model StreamProfile {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(64)
  codec       String   @default("h264") @db.VarChar(32)
  resolution  String?  @db.VarChar(32)
  fps         Int?     @default(25)
  bitrateKbps Int?     @map("bitrate_kbps")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("stream_profiles")
}

model Device {
  id                String     @id @default(uuid()) @db.Uuid
  name              String     @db.VarChar(128)
  // Starts the name of an evidence clip; a channel camera takes it from here unless it has its own.
  shortCode         String?    @map("short_code") @db.VarChar(20)
  // Code from masterdata type alert_level. Empty means the default level.
  alertLevel        String?    @map("alert_level") @db.VarChar(64)
  /// Still-image refresh for the live overview, in seconds; null takes the next level up (see snapshots/refresh-tiers.ts).
  snapshotRefreshSeconds Int? @map("snapshot_refresh_seconds")
  description       String?    @db.Text
  // Code from masterdata type device_type.
  deviceType        String     @default("dvr") @map("device_type") @db.VarChar(32)
  brand             String?    @db.VarChar(64)
  model             String?    @db.VarChar(64)
  serialNumber      String?    @map("serial_number") @db.VarChar(128)
  macAddress        String?    @map("mac_address") @db.VarChar(32)
  firmwareVersion   String?    @map("firmware_version") @db.VarChar(64)
  // The latest reading from the recorder itself: disks, clock, how far back it records.
  healthInfo        Json?      @map("health_info")
  /// Notes a person acknowledged (sub stream also recorded, H.265+ on purpose): { note: { by, at } }; see devices/health-notes-ack.ts.
  healthNotesAck    Json?      @map("health_notes_ack")
  healthCheckedAt   DateTime?  @map("health_checked_at")
  ipAddress         String     @map("ip_address") @db.VarChar(45)
  rtspPort          Int        @default(554) @map("rtsp_port")
  httpPort          Int?       @default(80) @map("http_port")
  onvifPort         Int?       @map("onvif_port")
  username          String?    @db.VarChar(128)
  passwordEncrypted String?    @map("password_encrypted") @db.Text
  totalChannels     Int        @default(1) @map("total_channels")
  status            String     @default("active") @db.VarChar(32)
  enabled           Boolean    @default(true)
  siteId            String?    @map("site_id") @db.Uuid
  zoneId            String?    @map("zone_id") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  site    Site?    @relation(fields: [siteId], references: [id])
  zone    Zone?    @relation(fields: [zoneId], references: [id])
  cameras Camera[]

  @@map("devices")
}

model Camera {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(128)
  description            String?                 @db.Text
  ipAddress              String?                 @map("ip_address") @db.VarChar(45)
  status                 CameraStatus            @default(inactive)
  timezone               String?                 @default("UTC") @db.VarChar(64)
  metadata               Json                    @default("{}")
  retentionPolicyId      String?                 @map("retention_policy_id") @db.Uuid
  templateId             String?                 @map("template_id") @db.Uuid
  enabled                Boolean                 @default(true)
  lastPolledAt           DateTime?               @map("last_polled_at")

  // CCTV Foundation fields (Phase 1)
  deviceId               String?                 @map("device_id") @db.Uuid
  channelNumber          Int?                    @map("channel_number")
  rtspUrl                String?                 @map("rtsp_url") @db.Text
  rtspUrlSub             String?                 @map("rtsp_url_sub") @db.Text
  streamProfile          String?                 @default("main") @map("stream_profile") @db.VarChar(32)
  mediaNodeId            String?                 @map("media_node_id") @db.Uuid
  streamPath             String?                 @unique @map("stream_path") @db.VarChar(128)
  // live_only: pulled from the camera/DVR only while someone watches, never recorded here (the
  // DVR/NVR keeps its own HDD). continuous: pulled all the time and recorded on this server.
  // Code from masterdata type camera_type.
  cameraType             String?                 @map("camera_type") @db.VarChar(64)
  // The camera itself. The recorder's brand decides how to connect; these are for finding and reporting.
  cameraBrand            String?                 @map("camera_brand") @db.VarChar(64)
  cameraModel            String?                 @map("camera_model") @db.VarChar(64)
  shortCode              String?                 @map("short_code") @db.VarChar(20)
  // Code from masterdata type alert_level. Empty means it follows its device.
  alertLevel             String?                 @map("alert_level") @db.VarChar(64)
  /// Privacy (e.g. HR rooms): every live, still, playback and clip view of it goes to the audit log.
  sensitive              Boolean                 @default(false)
  /// Still-image refresh for the live overview, in seconds; null takes the next level up (see snapshots/refresh-tiers.ts).
  snapshotRefreshSeconds Int? @map("snapshot_refresh_seconds")
  // What this outage has already raised, so a later check does not raise it again.
  outageAlertedAt        DateTime?               @map("outage_alerted_at")
  outageIncidentAt       DateTime?               @map("outage_incident_at")
  // This outage was raised as part of its whole recorder going down, not on its own.
  outageViaDevice        Boolean                 @default(false) @map("outage_via_device")
  /// What the recorder reports about this channel: main/sub stream settings, the signal coming in (analog), and an
  /// IP camera's model, serial and firmware. Read on the device health round; never written to the recorder.
  spec                   Json?                   @map("spec")
  recordingMode          String                  @default("live_only") @map("recording_mode") @db.VarChar(16)
  siteId                 String?                 @map("site_id") @db.Uuid
  zoneId                 String?                 @map("zone_id") @db.Uuid
  // A channel camera takes its site and zone from its device until someone sets its own.
  locationFromDevice     Boolean                 @default(true) @map("location_from_device")
  latitude               Float?                  @map("latitude")
  longitude              Float?                  @map("longitude")
  onvifProfileToken      String?                 @map("onvif_profile_token") @db.VarChar(128)
  streamState            String                  @default("idle") @map("stream_state") @db.VarChar(32)

  operationalStatus      CameraOperationalStatus @default(unknown) @map("operational_status")
  operationalSince       DateTime?               @map("operational_since")
  // Why it is offline, as far as the system can tell: no_signal, recorder_lost_camera, unreachable, stream_dropped, status_set.
  operationalReason      String?                 @map("operational_reason") @db.VarChar(32)
  slaTargetPercent       Float?                  @map("sla_target_percent")
  createdBy              String?                 @map("created_by") @db.VarChar(128)
  deletedAt              DateTime?               @map("deleted_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  retentionPolicy  RetentionPolicy?      @relation(fields: [retentionPolicyId], references: [id])
  template         CameraTemplate?       @relation(fields: [templateId], references: [id])
  device           Device?               @relation(fields: [deviceId], references: [id])
  site             Site?                 @relation(fields: [siteId], references: [id])
  zone             Zone?                 @relation(fields: [zoneId], references: [id])
  mediaNode        MediaNode?            @relation(fields: [mediaNodeId], references: [id])
  cameraEvents     CameraEvent[]
  dailySummaries   CameraDailySummary[]
  incidents        CameraIncident[]
  groupMemberships CameraGroupMember[]
  favorites        CameraFavorite[]
  recordings       CameraRecording[]
  recordingClips   RecordingClip[]

  @@map("cameras")
}


model CameraEvent {
  id             BigInt          @id @default(autoincrement())
  cameraId       String          @map("camera_id") @db.Uuid
  eventType      CameraEventType @map("event_type")
  message        String          @db.Text
  metadata       Json?           @default("{}")
  downtimeReason String?         @map("downtime_reason") @db.VarChar(64)
  source         String?         @db.VarChar(32)
  createdAt      DateTime        @default(now()) @map("created_at")

  camera   Camera          @relation(fields: [cameraId], references: [id])
  incident CameraIncident?

  @@index([cameraId, createdAt(sort: Desc)])
  @@map("camera_events")
}

model CameraDailySummary {
  id                  String   @id @default(uuid()) @db.Uuid
  cameraId            String   @map("camera_id") @db.Uuid
  date                DateTime @db.Date
  uptimeSeconds       Int      @default(0) @map("uptime_seconds")
  downtimeSeconds     Int      @default(0) @map("downtime_seconds")
  maintenanceSeconds  Int      @default(0) @map("maintenance_seconds")
  offlineCount        Int      @default(0) @map("offline_count")
  onlineCount         Int      @default(0) @map("online_count")
  imagesCaptured      Int      @default(0) @map("images_captured")
  estimatedLostImages Int      @default(0) @map("estimated_lost_images")
  avgResponseSeconds  Float    @default(0) @map("avg_response_seconds")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  camera Camera @relation(fields: [cameraId], references: [id])

  @@unique([cameraId, date])
  @@map("camera_daily_summaries")
}

model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  alertType      AlertType     @map("alert_type")
  severity       AlertSeverity @default(warning)
  source         String?       @db.VarChar(256)
  title          String        @db.VarChar(256)
  message        String        @db.Text
  details        Json?         @default("{}")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  acknowledgedBy String?       @map("acknowledged_by") @db.VarChar(128)
  resolvedAt     DateTime?     @map("resolved_at")
  resolvedBy     String?       @map("resolved_by") @db.VarChar(128)
  // In the trash: closed, out of every list and count, until restored or deleted for good.
  deletedAt      DateTime?     @map("deleted_at")
  deletedBy      String?       @map("deleted_by") @db.VarChar(128)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([severity, createdAt(sort: Desc)])
  @@index([deletedAt])
  @@map("alerts")
}

model AlertRule {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(128)
  alertType            AlertType @map("alert_type")
  description          String?   @db.Text
  enabled              Boolean   @default(true)
  condition            Json
  cooldownMinutes      Int       @default(60) @map("cooldown_minutes")
  notificationChannels Json      @default("[]") @map("notification_channels")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@map("alert_rules")
}

model SystemSetting {
  key       String   @id @db.VarChar(128)
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

enum TelegramUserStatus {
  pending
  approved
  rejected

  @@map("telegram_user_status")
}

/// People allowed to talk to the bot in a private chat. The group chat itself is always
/// allowed (it is the configured alert destination); this list only gates 1:1 DMs, where
/// there is no group membership to lean on and anyone who finds the bot's @username can
/// message it. Approval is granted from the group by a Telegram group admin.
model TelegramUser {
  id          String             @id @default(uuid()) @db.Uuid
  telegramId  String             @unique @map("telegram_id") @db.VarChar(32)
  firstName   String?            @map("first_name") @db.VarChar(128)
  username    String?            @db.VarChar(128)
  status      TelegramUserStatus @default(pending)
  requestedAt DateTime           @default(now()) @map("requested_at")
  decidedAt   DateTime?          @map("decided_at")
  /// Who approved/rejected — a Telegram display name for in-chat decisions, or a
  /// web username when an operator adds/removes someone from the settings page.
  decidedBy   String?            @map("decided_by") @db.VarChar(128)
  lastSeenAt  DateTime?          @map("last_seen_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([status])
  @@map("telegram_users")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(128)
  tokenHash   String    @unique @map("token_hash") @db.Text
  tokenPrefix String    @map("token_prefix") @db.VarChar(16)
  permissions Json      @default("[]")
  enabled     Boolean   @default(true)
  expiresAt   DateTime? @map("expires_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdBy   String?   @map("created_by") @db.VarChar(128)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tokenHash])
  @@map("api_keys")
}

// Work handed to someone outside, such as a repair company. One per incident.
model WorkOrder {
  id             String    @id @default(uuid()) @db.Uuid
  number         String    @unique @db.VarChar(64)
  incidentId     String    @unique @map("incident_id") @db.Uuid
  status         String    @default("open") @db.VarChar(32)
  vendorCompany  String?   @map("vendor_company") @db.VarChar(200)
  technicianName String?   @map("technician_name") @db.VarChar(200)
  contactPhone   String?   @map("contact_phone") @db.VarChar(64)
  scheduledAt    DateTime? @map("scheduled_at")
  completedAt    DateTime? @map("completed_at")
  parts          String?   @db.Text
  cost           Decimal?  @db.Decimal(12, 2)
  notes          String?   @db.Text
  attachments    Json      @default("[]")
  createdBy      String?   @map("created_by") @db.VarChar(128)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  incident CameraIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("work_orders")
}

// The last number issued for each kind of document and year. It only goes up, so deleting a record never frees its number.
model DocumentCounter {
  key   String @id @db.VarChar(32)
  value Int

  @@map("document_counters")
}

model Masterdata {
  id          String   @id @default(uuid()) @db.Uuid
  type        String   @db.VarChar(64)
  code        String   @db.VarChar(64)
  nameTh      String?  @map("name_th") @db.VarChar(256)
  nameEn      String?  @map("name_en") @db.VarChar(256)
  nameCn      String?  @map("name_cn") @db.VarChar(256)
  nameMm      String?  @map("name_mm") @db.VarChar(256)
  nameJp      String?  @map("name_jp") @db.VarChar(256)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  // Extra settings of a type, e.g. the RTSP patterns of a device_brand.
  config      Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([type, code])
  @@index([type, sortOrder])
  @@map("masterdata")
}

model SystemConfig {
  key         String   @id @db.VarChar(128)
  value       String   @db.Text
  description String?  @db.Text
  valueType   String   @default("string") @map("value_type") @db.VarChar(32)
  category    String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entity      String   @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  description String?  @db.Text
  metadata    Json?    @default("{}")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], map: "fk_audit_log_user")

  @@index([createdAt(sort: Desc)])
  @@index([action, entity])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model BackupRecord {
  id           String    @id @default(uuid()) @db.Uuid
  type         String    @db.VarChar(32)
  status       String    @default("pending") @db.VarChar(32)
  filePath     String?   @map("file_path") @db.Text
  fileSize     BigInt?   @map("file_size")
  checksum     String?   @db.Char(64)
  startedAt    DateTime  @default(now()) @map("started_at")
  completedAt  DateTime? @map("completed_at")
  errorMessage String?   @map("error_message") @db.Text
  metadata     Json?     @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([type, status])
  @@index([startedAt(sort: Desc)])
  @@map("backup_records")
}

model CameraIncident {
  id               String    @id @default(uuid()) @db.Uuid
  incidentNumber   String    @unique @map("incident_number") @db.VarChar(32)
  cameraId         String    @map("camera_id") @db.Uuid
  eventId          BigInt?   @unique @map("event_id")
  fromStatus       String    @map("from_status") @db.VarChar(32)
  toStatus         String    @map("to_status") @db.VarChar(32)
  reason           String    @db.VarChar(64)
  rootCause        String?   @map("root_cause") @db.VarChar(64)
  description      String?   @db.Text
  resolution       String?   @db.Text
  correctiveAction String?   @map("corrective_action") @db.Text
  preventiveAction String?   @map("preventive_action") @db.Text
  estimatedFinish  DateTime? @map("estimated_finish")
  actualFinish     DateTime? @map("actual_finish")
  lostImages       Int       @default(0) @map("lost_images")
  priority         String    @default("medium") @db.VarChar(16)
  impact           String    @default("none") @db.VarChar(32)
  assignedTo       String?   @map("assigned_to") @db.VarChar(128)
  workflowStage    String    @default("unassigned") @map("workflow_stage") @db.VarChar(20)
  acknowledgedAt   DateTime? @map("acknowledged_at")
  acknowledgedBy   String?   @map("acknowledged_by") @db.VarChar(128)
  problemDesc      String?   @map("problem_desc") @db.Text
  resolutionDesc   String?   @map("resolution_desc") @db.Text
  attachments      Json      @default("[]")
  observers        Json      @default("[]")
  workOrderNumber  String?   @map("work_order_number") @db.VarChar(64)
  workOrderStatus  String?   @map("work_order_status") @db.VarChar(32)
  // open, then pending while someone checks the work, then resolved. Closed-at is when the work was finished.
  status           String    @default("open") @db.VarChar(16)
  verifiedBy       String?   @map("verified_by") @db.VarChar(128)
  verifiedAt       DateTime? @map("verified_at")
  verificationNote String?   @map("verification_note") @db.Text
  verificationLog  Json      @default("[]") @map("verification_log")
  openedBy         String?   @map("opened_by") @db.VarChar(128)
  closedBy         String?   @map("closed_by") @db.VarChar(128)
  openedAt         DateTime  @default(now()) @map("opened_at")
  closedAt         DateTime? @map("closed_at")
  detectionSource     String?  @map("detection_source") @db.VarChar(32)
  rootCauseConfidence String?  @map("root_cause_confidence") @db.VarChar(16)
  autoResolved        Boolean  @default(false) @map("auto_resolved")
  // The camera dropped again soon after this closed itself, so the same incident carried on.
  reopenCount         Int       @default(0) @map("reopen_count")
  lastReopenedAt      DateTime? @map("last_reopened_at")
  // Set when one incident stands for a whole recorder going down. The camera above is the first one found.
  deviceId            String?   @map("device_id") @db.Uuid
  // [{ id, name, channel }] for every camera of that recorder this incident covers.
  affectedCameras     Json      @default("[]") @map("affected_cameras")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  camera         Camera          @relation(fields: [cameraId], references: [id])
  event          CameraEvent?    @relation(fields: [eventId], references: [id])
  recordingClips RecordingClip[]
  workOrder      WorkOrder?

  @@index([deviceId, status])
  @@map("camera_incidents")
}

// ── CCTV Recording & Playback Models (Phase 4) ─────────────────

model CameraRecording {
  id              String    @id @default(uuid()) @db.Uuid
  cameraId        String    @map("camera_id") @db.Uuid
  streamPath      String    @map("stream_path") @db.VarChar(128)
  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")
  durationSeconds Float     @default(0) @map("duration_seconds")
  filePath        String    @map("file_path") @db.Text
  fileSizeBytes   BigInt    @default(0) @map("file_size_bytes")
  format          String    @default("fmp4") @db.VarChar(16)
  hasIncident     Boolean   @default(false) @map("has_incident")
  incidentCount   Int       @default(0) @map("incident_count")
  legalHold       Boolean   @default(false) @map("legal_hold")
  isArchived      Boolean   @default(false) @map("is_archived")
  // When cleanup moved the file to quarantine; it is purged RECORDINGS_QUARANTINE_PURGE_DAYS later.
  archivedAt      DateTime? @map("archived_at")
  retentionUntil  DateTime? @map("retention_until")
  storageType     String    @default("local") @map("storage_type") @db.VarChar(32)
  storageNode     String?   @map("storage_node") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  camera          Camera    @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, startTime(sort: Desc)])
  @@index([cameraId, endTime(sort: Desc)])
  @@index([legalHold])
  @@map("camera_recordings")
}

model RecordingClip {
  id                String          @id @default(uuid()) @db.Uuid
  cameraId          String          @map("camera_id") @db.Uuid
  incidentId        String?         @map("incident_id") @db.Uuid
  title             String          @db.VarChar(256)
  description       String?         @db.Text
  startTime         DateTime        @map("start_time")
  endTime           DateTime        @map("end_time")
  durationSeconds   Float           @map("duration_seconds")
  filePath          String?         @map("file_path") @db.Text
  fileSizeBytes     BigInt?         @map("file_size_bytes")
  format            String          @default("mp4") @db.VarChar(16)
  status            String          @default("ready") @db.VarChar(32) // pending, processing, ready, failed
  hasPreBuffer      Boolean         @default(true) @map("has_pre_buffer")
  preBufferSeconds  Int             @default(30) @map("pre_buffer_seconds")
  postBufferSeconds Int             @default(60) @map("post_buffer_seconds")
  legalHold         Boolean         @default(false) @map("legal_hold")
  sha256Hash        String?         @map("sha256_hash") @db.VarChar(64)
  chainOfCustody    Json?           @default("[]") @map("chain_of_custody")
  downloadUrl       String?         @map("download_url") @db.Text
  exportedBy        String?         @map("exported_by") @db.VarChar(128)
  /// In the trash: the file sits in quarantine (<quarantine>/clips) and comes back on restore; purged for good
  /// RECORDINGS_QUARANTINE_PURGE_DAYS later. Set by a person (password confirmed) or by clips_retention_days.
  deletedAt         DateTime?       @map("deleted_at")
  deletedBy         String?         @map("deleted_by") @db.VarChar(128)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  camera            Camera          @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  incident          CameraIncident? @relation(fields: [incidentId], references: [id])

  @@index([cameraId, createdAt(sort: Desc)])
  @@index([status])
  @@index([deletedAt])
  @@map("recording_clips")
}

model SignoffRecord {
  id         String   @id @default(uuid()) @db.Uuid
  phase      String   @db.VarChar(32)
  role       String   @db.VarChar(64)
  signoffBy  String   @map("signoff_by") @db.VarChar(128)
  signedAt   DateTime @default(now()) @map("signed_at")
  comment    String?  @db.Text
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([phase])
  @@map("signoff_records")
}
