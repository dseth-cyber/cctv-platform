# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://image_user:image_pass@localhost:5432/image_db

# JWT
JWT_SECRET=change-this-to-a-secure-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=image-service
MINIO_USE_SSL=false

# Encryption (for SMB passwords in DB)
ENCRYPTION_KEY=change-this-to-a-32-char-encryption-key

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_ACCESS_TOKEN=

# MediaMTX & Streaming
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888

# Media Webhook Secret (MediaMTX runOnReady / runOnNotReady Webhook Authentication)
MEDIA_WEBHOOK_SECRET=cctv-media-webhook-secret-dev

# Public Base URL (Used for notification links and external references)
PUBLIC_BASE_URL=http://localhost:5173

# WFH & Remote TURN Server Configuration (Dynamic RFC 5766 HMAC)
TURN_SERVER_URL=turn.cctv-local.lc.co.th:3478
TURN_SECRET=cctv-secure-turn-key-prod-default

# FFmpeg Clip Export Concurrency Queue (Default: 2 concurrent tasks)
MAX_CONCURRENT_EXPORTS=2

# Disk Storage High-Watermark & Emergency Eviction Thresholds (%)
DISK_WARNING_THRESHOLD_PCT=85
DISK_CRITICAL_THRESHOLD_PCT=92

# Recordings Directory Path (Defaults to ./recordings); must be the same mount MediaMTX records into
RECORDINGS_DIR=
# Recording cleanup is off until a retention policy is approved; when on, files move to quarantine (never deleted)
RECORDINGS_CLEANUP_ENABLED=false
RECORDINGS_QUARANTINE_DIR=

# Synthetic Timeline Seeding (false for production; fail-closed against fake data)
SEED_SYNTHETIC_RECORDINGS=false

