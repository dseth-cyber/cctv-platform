# CCTV Web App Frontend — Environment Configuration
# Note: Vite exposes variables prefixed with VITE_ to the client bundle.

# Base API endpoint URL (defaults to same-origin reverse proxy /image-service/api/v1)
VITE_API_BASE_URL=/image-service/api/v1

# MediaMTX WebRTC (WHEP) Streaming Server URL (Used for direct player connections)
VITE_MEDIAMTX_WHEP_URL=http://localhost:8889

# MediaMTX HLS Streaming Server URL
VITE_MEDIAMTX_HLS_URL=http://localhost:8888

# Application Display Title
VITE_APP_TITLE=CCTV Platform

# Default Timezone for timestamps and overlays (RFC Standard: Asia/Bangkok)
VITE_DEFAULT_TIMEZONE=Asia/Bangkok
