# Copy to .env and fill in real values before deploying. Every secret below MUST be
# changed from any example/placeholder shown here.
#
# CCTV Platform — Dev Environment Configuration (Isolated from Production)

# === Global ===
# Project prefix for containers, volumes, and networks
COMPOSE_PROJECT_NAME=cctv-platform

# === Dev Host Ports (Localhost bindings) ===
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# === Safety & Isolation Flags (Fail-Closed Defaults) ===
ALLOW_DATA_LOSS=false
RUN_SEED=false

# === Grafana Image Renderer (internal grafana->renderer auth token) ===
GF_RENDERER_TOKEN=changeme-renderer-token

# === PostgreSQL ===
POSTGRES_USER=cctv_user
POSTGRES_PASSWORD=changeme-generate-a-long-random-value
POSTGRES_DB=cctv_db

# === JWT (generate with: openssl rand -hex 48) ===
JWT_SECRET=changeme-generate-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === MinIO (only used if S3 storage provider is active) ===
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme-generate-a-long-random-value
MINIO_BUCKET=cctv-storage

# === SeaweedFS (storage backend) ===
SEAWEEDFS_ACCESS_KEY=changeme
SEAWEEDFS_SECRET_KEY=changeme-generate-a-long-random-value
SEAWEEDFS_BUCKET=cctv-storage

# === Encryption Key (passwords stored at rest) ===
ENCRYPTION_KEY=changeme-generate-a-long-random-value

# === Service API Key (internal service-to-service auth) ===
SERVICE_API_KEY=changeme-generate-a-long-random-value

# === SMB Server (mock fixture only) ===
SMB_USER=camera
SMB_PASSWORD=changeme

# === Cloudflare Tunnel (Disabled by default in Dev; use --profile tunnel to run) ===
TUNNEL_TOKEN=

# === CORS Allowed Origins ===
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8443

# === MediaMTX Streaming Server ===
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888
