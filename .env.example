# Copy to .env and fill in real values before deploying. Every secret below MUST be
# changed from any example/placeholder shown here.
#
# CCTV Platform — Dev Environment Configuration (Isolated from Production)

# === Global ===
# Project prefix for containers, volumes, and networks
COMPOSE_PROJECT_NAME=cctv-platform

# === Dev Host Ports (Localhost bindings) ===
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# === Safety & Isolation Flags (Fail-Closed Defaults) ===
ALLOW_DATA_LOSS=false
RUN_SEED=false

# === Grafana Image Renderer (internal grafana->renderer auth token) ===
GF_RENDERER_TOKEN=changeme-renderer-token

# === PostgreSQL ===
POSTGRES_USER=cctv_user
POSTGRES_PASSWORD=changeme-generate-a-long-random-value
POSTGRES_DB=cctv_db

# === JWT (generate with: openssl rand -hex 48) ===
JWT_SECRET=changeme-generate-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === MinIO (only used if S3 storage provider is active) ===
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme-generate-a-long-random-value
MINIO_BUCKET=cctv-storage

# === SeaweedFS (storage backend) ===
SEAWEEDFS_ACCESS_KEY=changeme
SEAWEEDFS_SECRET_KEY=changeme-generate-a-long-random-value
SEAWEEDFS_BUCKET=cctv-storage

# === Encryption Key (passwords stored at rest) ===
ENCRYPTION_KEY=changeme-generate-a-long-random-value

# === Service API Key (internal service-to-service auth) ===
SERVICE_API_KEY=changeme-generate-a-long-random-value

# === Cloudflare Tunnel (Disabled by default in Dev; use --profile tunnel to run) ===
TUNNEL_TOKEN=

# === CORS Allowed Origins ===
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://localhost:8443

# === MediaMTX Streaming Server ===
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_WEBRTC_URL=http://localhost:8889
MEDIAMTX_HLS_URL=http://localhost:8888

# === Media Webhook Secret (MediaMTX <-> image-api) ===
# Shared secret header (x-media-webhook-secret) for event-driven stream status (< 3s detection)
MEDIA_WEBHOOK_SECRET=changeme-generate-a-long-random-value

# === Public Base URL ===
# Public domain or URL the system is reachable at (used in incident links & notifications)
PUBLIC_BASE_URL=http://localhost:8080

# === WFH & Remote Access ICE / TURN Server (RFC 5766) ===
# Host and secret for generating dynamic time-limited HMAC credentials
TURN_SERVER_URL=turn.cctv-local.lc.co.th:3478
TURN_SECRET=changeme-generate-a-long-random-value

# === FFmpeg Clip Export Concurrency Queue ===
# Maximum concurrent fMP4 export worker tasks (prevents CPU/IO saturation, default: 2)
MAX_CONCURRENT_EXPORTS=2

# === Disk Storage High-Watermark & Emergency Eviction ===
# Warning threshold (85%) triggers system alert; Critical threshold (92%) raises a critical alert and,
# when RECORDINGS_CLEANUP_ENABLED=true, permanently deletes the oldest non-legal-hold recordings
# (quarantined ones first) until < 85%. Checked every 10 minutes; every deletion is audited.
DISK_WARNING_THRESHOLD_PCT=85
DISK_CRITICAL_THRESHOLD_PCT=92
# Retention policy (approved 2026-11-03): recordings older than the camera's policy days (fallback
# RECORDING_RETENTION_DAYS) move to quarantine; quarantine is deleted after RECORDINGS_QUARANTINE_PURGE_DAYS.
# Legal Hold always wins. Set false to stop all automatic moves/deletions.
RECORDINGS_CLEANUP_ENABLED=true
RECORDING_RETENTION_DAYS=30
RECORDINGS_QUARANTINE_PURGE_DAYS=7
# Put quarantine on a different volume if eviction must actually free space on the recordings disk
RECORDINGS_QUARANTINE_DIR=/recordings/.quarantine

# === Synthetic Timeline Seeding ===
# Set to false for Production (returns accurate empty timelines); only true for offline dev demo
SEED_SYNTHETIC_RECORDINGS=false

